{
  "name": "claris-impact-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based viewer for ClarisImpact documents",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render": "node --experimental-strip-types scripts/render.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
